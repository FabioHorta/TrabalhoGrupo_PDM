<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_verde"
    tools:context=".TipoEnergia">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Melhor Tipo de Energia"
            android:textColor="@color/green"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:gravity="center" />

        <!-- Botão para obter localização -->
        <Button
            android:id="@+id/btnObterLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Melhor Tipo de Energia"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Resultado -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            android:padding="10dp" />

        <!-- Botão para voltar ao menu -->
        <Button
            android:id="@+id/btnVoltarMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar ao Menu"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
