<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_verde">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerClasse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E4D42">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classe de Consumo"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:alpha="0.8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleciona a eficiência de cada eletrodoméstico"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- CONTEÚDO SCROLLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/layoutBotoes"
        android:layout_below="@+id/headerClasse">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FAFAFA">

            <!-- LEGENDA CORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_material_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Classes de Eficiência Energética:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E4D42"
                    android:layout_marginBottom="8dp" />

                <!-- Legenda A-B Verde -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#00A86B"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A-B: Muito eficiente"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- Legenda C Amarelo Limão -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#CDDC39"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="C: Eficiente"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- Legenda D Ouro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#FFD700"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="D: Médio (padrão)"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- Legenda E-F Laranja -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#FFA500"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-F: Pouco eficiente"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- Legenda G Vermelho -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#DC143C"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="G: Muito ineficiente"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

            </LinearLayout>

            <!-- CONTAINER ELETRODOMÉSTICOS -->
            <LinearLayout
                android:id="@+id/containerClasseConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTÕES FIXOS AO FUNDO -->
    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnProximoClasse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo - Mapa de Gastos"
            android:backgroundTint="#1E4D42"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnVoltarClasse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:backgroundTint="#666666"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="12dp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</RelativeLayout>