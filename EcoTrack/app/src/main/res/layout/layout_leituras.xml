<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_verde"
    android:orientation="vertical">

    <!-- HEADER COM NOME DA CASA -->
    <LinearLayout
        android:id="@+id/headerCasa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E4D42">

        <TextView
            android:text="Resumo de Leituras"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:alpha="0.8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvNomeCasaResumo"
            android:text="Casa Avó"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- CONTEÚDO SCROLLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD ÚLTIMA LEITURA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="#FFFFFF"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:layout_marginEnd="16dp"
                    app:tint="#2E7D32" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Última Leitura Registada"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                    <TextView
                        android:id="@+id/tvConsumoResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- kWh"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"/>

                    <TextView
                        android:id="@+id/tvDataResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data: --/--/----"
                        android:textSize="12sp"
                        android:textColor="#777777"/>
                </LinearLayout>
            </LinearLayout>

            <!-- TÍTULO HISTÓRICO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico Completo de Leituras"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="12dp"/>

            <!-- CABEÇALHO TABELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#E0E0E0">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Data"
                    android:textColor="#000000"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Foto"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Valor"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text=""
                    android:gravity="center"/>
            </LinearLayout>

            <!-- TABELA HISTÓRICO -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:fillViewport="true"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <TableLayout
                    android:id="@+id/tabelaHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />
            </ScrollView>

            <!-- DETALHES CONTRATO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalhes do Contrato"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Potência Contratada: 6.9 kVA"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tarifa: Bi-horária"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginBottom="16dp"/>

            <!-- BOTÃO VOLTAR -->
            <Button
                android:id="@+id/btnVoltarResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voltar a Inserir Leituras"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>