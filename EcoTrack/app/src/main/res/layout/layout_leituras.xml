<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_verde">

    <!-- 🔵 HEADER NOVO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCasa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackArrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/green"
            android:contentDescription="Voltar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvNomeCasaResumo"
            app:layout_constraintBottom_toBottomOf="@id/tvNomeCasaResumo" />

        <TextView
            android:id="@+id/tvLabelCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTO COMPLETO"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintStart_toEndOf="@id/btnBackArrow"
            app:layout_constraintBottom_toTopOf="@id/tvNomeCasaResumo" />

        <TextView
            android:id="@+id/tvNomeCasaResumo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minha Casa"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBackArrow"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- 🔽 SCROLLVIEW COM FUNDO VERDE -->
    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@drawable/gradient_verde"
        app:layout_constraintTop_toBottomOf="@id/headerCasa"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">


            <!-- CARTÃO ÚLTIMA LEITURA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#1E4D42"
                        android:background="@drawable/bg_circle_green_alpha"
                        android:padding="12dp"
                        android:layout_marginEnd="20dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ÚLTIMA LEITURA"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConsumoResumo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- kWh"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#1E4D42"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvDataResumo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registada em: --/--/----"
                            android:textSize="13sp"
                            android:textColor="#888888"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- TÍTULO REGISTO COMPLETO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registo Completo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp" />



            <!-- CARD DA TABELA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- HEADER TABELA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#E8F5E9">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="DATA"
                            android:textColor="#1E4D42"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="FOTO"
                            android:gravity="center"
                            android:textColor="#1E4D42"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VALOR (kWh)"
                            android:gravity="end"
                            android:textColor="#1E4D42"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- TABELA DINÂMICA -->
                    <TableLayout
                        android:id="@+id/tabelaHistorico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>




            <!-- BOTÃO VOLTAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltarResumo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Voltar a Inserir"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                android:textColor="#1E4D42"
                app:cornerRadius="30dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp"/>

        </LinearLayout>
    </ScrollView>



    <!-- ⚪ BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        android:background="#FFFFFF"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
