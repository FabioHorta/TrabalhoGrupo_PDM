<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_verde"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="60dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalhes da Casa"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="#FFFFFF"
            android:hint="Nome da Casa (ex: Casa de Férias)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNomeCasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Localização"
            android:textColor="#1E4D42"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Morada">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMorada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:hint="Distrito">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/autoCompleteDistrito" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="Concelho">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/autoCompleteCidade" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:hint="Freguesia">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/autoCompleteFreguesia" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="CP">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCodPostal" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 Tipo de Habitação"
            android:textColor="#1E4D42"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/btnApartamento"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_option_unselected"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconApt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_dialog_map"
                    app:tint="#555555"/>
                <TextView
                    android:id="@+id/txtApt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apartamento"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMoradia"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_option_unselected"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconMoradia"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#555555"/>
                <TextView
                    android:id="@+id/txtMoradia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moradia"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Tipo de Utilização"
            android:textColor="#1E4D42"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermanente"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Permanente"
                android:textColor="#1E4D42"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSazonal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Sazonal"
                android:textColor="#1E4D42"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 Número de Habitantes"
            android:textColor="#1E4D42"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnP1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="1" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="4dp" app:cornerRadius="25dp" android:insetLeft="0dp" android:insetRight="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnP2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="2" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="4dp" app:cornerRadius="25dp" android:insetLeft="0dp" android:insetRight="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnP3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="3" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="4dp" app:cornerRadius="25dp" android:insetLeft="0dp" android:insetRight="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnP4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="4" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="4dp" app:cornerRadius="25dp" android:insetLeft="0dp" android:insetRight="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnP5" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="5+" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="4dp" app:cornerRadius="25dp" android:insetLeft="0dp" android:insetRight="0dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏗️ Ano de Construção"
            android:textColor="#1E4D42"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnAno1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Antes de 1980" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="match_parent" android:layout_height="55dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAno2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="1980 - 2000" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="match_parent" android:layout_height="55dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAno3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="2001 - 2010" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="match_parent" android:layout_height="55dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAno4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Após 2010" android:textColor="#1E4D42" android:backgroundTint="#FFFFFF" app:strokeColor="#CCCCCC" app:strokeWidth="1dp" android:layout_width="match_parent" android:layout_height="55dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGuardar"
            android:text="Seguinte: Eletrodomésticos ➔"
            android:backgroundTint="@color/green"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>