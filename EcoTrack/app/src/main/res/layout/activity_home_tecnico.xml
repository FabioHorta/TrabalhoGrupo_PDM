<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_gradiente">

    <ImageView
        android:id="@+id/imgAvatarTecnico"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_tecnico"
        android:contentDescription="@string/tecnico"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvBemVindoTecnico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bem-vindo, Técnico"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toEndOf="@id/imgAvatarTecnico"
        app:layout_constraintTop_toTopOf="@id/imgAvatarTecnico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/imgAvatarTecnico"
        android:layout_marginStart="16dp" />

    <!-- Card Próxima Visita -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProximaVisita"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/imgAvatarTecnico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvProximaVisitaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próxima visita"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProximaVisitaNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nome / descrição"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProximaVisitaDataHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="25 de abril • 10:00" />

            <TextView
                android:id="@+id/tvProximaVisitaMoradaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estado: Pendente" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Zona de resumos por baixo da card -->
    <LinearLayout
        android:id="@+id/layoutResumos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardProximaVisita"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvResumoAssistencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assistências agendadas: 0"
            android:textSize="16sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvResumoMensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensagens recebidas: 0"
            android:textSize="16sp"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavTecnico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/menu_bottom_tecnico"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
