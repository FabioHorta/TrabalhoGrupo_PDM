<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- fundo muito claro -->
    <solid android:color="#F3F3F3" />

    <!-- cantos arredondados -->
    <corners android:radius="12dp" />

    <!-- ligeira borda cinza -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- padding interno -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
