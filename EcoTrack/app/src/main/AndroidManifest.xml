<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MenuPrincipal"
            android:exported="true" />

        <activity
            android:name=".CalculadoraCustos"
            android:exported="false" />

        <activity
            android:name=".ResumoLeituras"
            android:exported="false" />

        <activity
            android:name=".ApoioCliente"
            android:exported="false" />

        <activity
            android:name=".AlertasConsumo"
            android:exported="false" />

        <activity
            android:name=".LeiturasMensais"
            android:exported="false" />

        <activity
            android:name=".EstimativaConsumo"
            android:exported="false" />

        <activity
            android:name=".TipoEnergia"
            android:exported="false" />

        <activity android:name=".AgendarAssistencia"
            android:exported="false" />

        <activity android:name=".EnviarMensagem"
            android:exported="false" />

        <activity android:name=".Relatorios"
            android:exported="false" />

    </application>

</manifest>